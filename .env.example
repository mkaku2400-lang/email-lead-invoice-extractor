# Copy this file to ".env" and fill in ONE of the API keys.
# With no key, the dashboard still runs in Demo Mode.

# Which provider to use when more than one key is set: anthropic, openai or gemini
LLM_PROVIDER=anthropic

# --- Anthropic Claude (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
# claude-opus-5-5 (best quality) | claude-sonnet-5-5 (cheaper) | claude-haiku-5-5 (cheapest)
ANTHROPIC_MODEL=claude-opus-5-5

# --- OpenAI (https://platform.openai.com) ---
OPENAI_API_KEY=
# Set this to a chat model available on your OpenAI account.
OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
